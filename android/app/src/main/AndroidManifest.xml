<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network & Connectivity -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Primary Voice Interaction (SpeechRecognizer + Music Beat Visualizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera & Computer Vision (Only activated on user permission & Vision screen open) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Local User-Selected Music Playback -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Optional Coarse Location for Local Live Weather (City search also works without GPS) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Hardware features declared optional so all Android phones & tablets are supported -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <!-- Required on Android 11+ (API 30+) for SpeechRecognizer & TextToSpeech service discovery -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".NexApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NEX6"
        android:usesCleartextTraffic="false">

        <!-- Pure Full-Screen Robot Face Activity -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- OS Home-Screen App Icon Shortcut for External Backend & Privacy Setup -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- External Backend HTTPS URL, Privacy & Custom Eye Setup (Opened from OS App Shortcut,
             Android System App Preferences, or nex6://setup deep link — NEVER from Main Face) -->
        <activity
            android:name=".BackendSetupActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:label="NEX Backend &amp; Privacy Setup"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="setup"
                    android:scheme="nex6" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AnimalSoundsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".VisionActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".MusicDanceActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".GamesHubActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".MiniGameActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".WeatherTimeActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

    </application>

</manifest>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left Pane: Live Local Time, Date & Connectivity -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.95"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackFromWeather"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1E3346"
                android:text="← Face"
                android:textAllCaps="false"
                android:textColor="@color/nex_text_primary"
                android:textSize="12sp" />

            <com.nex.robotpet.v6.ui.RobotEyesView
                android:id="@+id/weatherMiniEyes"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLiveClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="--:--:--"
            android:textColor="@color/nex_cyan"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLiveDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Loading date..."
            android:textColor="@color/nex_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvInternetDiagnostic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Network: Checking..."
            android:textColor="@color/nex_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSpeakTimeWeather"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#00695C"
            android:text="Speak Time &amp; Weather"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right Pane: Real Live Weather (Open-Meteo HTTPS API) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1.25"
        android:background="@drawable/bg_cyber_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etWeatherCity"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_button"
                android:hint="Enter city (e.g. Bagaha, Patna)"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Bagaha"
                android:textColor="@color/nex_text_primary"
                android:textColorHint="#668FB3C9"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnFetchCityWeather"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#00838F"
                android:text="Check"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFetchGpsWeather"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#1E3346"
                android:text="GPS"
                android:textAllCaps="false"
                android:textColor="@color/nex_text_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickBagaha"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:backgroundTint="#172A3A"
                android:text="Bagaha"
                android:textAllCaps="false"
                android:textColor="@color/nex_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickPatna"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#172A3A"
                android:text="Patna"
                android:textAllCaps="false"
                android:textColor="@color/nex_text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnQuickDelhi"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#172A3A"
                android:text="New Delhi"
                android:textAllCaps="false"
                android:textColor="@color/nex_text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvWeatherDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="Tap 'Check' to fetch live meteorological weather from Open-Meteo."
                android:textColor="@color/nex_text_primary"
                android:textSize="14sp" />
        </ScrollView>

    </LinearLayout>

</LinearLayout>
